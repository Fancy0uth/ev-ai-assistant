{
  "name": "ev-ai-assistant",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:core": "npm run dev --workspace @ev/core",
    "dev:web": "npm run dev --workspace @ev/web",
    "test:legacy": "node --test tests/dashboard.test.mjs tests/e2e-runner.test.mjs",
    "test": "npm run test:legacy && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tsx": "4.23.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
