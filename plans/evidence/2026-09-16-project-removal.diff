-function completedAssistantItemTexts(jsonLines) {
-  const texts = [];
-  for (const line of jsonLines.split(/\r?\n/)) {
-    if (!line.trim()) continue;
-    try {
-      const event = JSON.parse(line);
-      const item = event?.item;
-      const isAssistant = item?.role === "assistant" || item?.type === "agent_message" || item?.type === "assistant_message";
-      if (event?.type === "item.completed" && isAssistant && typeof item.text === "string") texts.push(item.text);
-    } catch {
-      // Non-JSON diagnostics cannot satisfy the fixed-text success condition.
-    }
-  }
-  return texts;
-}
