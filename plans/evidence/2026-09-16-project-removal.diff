-def remaining_timeout(deadline: float, maximum: float) -> float:
-    remaining = deadline - time.monotonic()
-    if remaining <= 0:
-        raise ClientError("CLIENT_LIFETIME")
-    return min(maximum, remaining)
-
-
-def relay_tunnel(
-    left: socket.socket, right: socket.socket, *, process_deadline: float = float("inf")
-) -> None:
-    """Forward a bounded byte stream between loopback and the Unix gateway."""
-    transferred = 0
-    started = time.monotonic()
-    tunnel_deadline = min(started + MAX_LIFETIME_SECONDS, process_deadline)
-    idle_deadline = started + IDLE_TIMEOUT_SECONDS
-
-    def relay_timeout() -> float | None:
-        now = time.monotonic()
-        if now >= process_deadline or now >= tunnel_deadline or now >= idle_deadline:
-            return None
-        return min(process_deadline - now, tunnel_deadline - now, idle_deadline - now)
-
-    try:
-        while True:
-            timeout = relay_timeout()
-            if timeout is None:
-                return
-            left.settimeout(timeout)
-            right.settimeout(timeout)
-            readable, _writable, _exceptional = select.select(
-                [left, right], [], [], timeout
-            )
-            if not readable:
-                continue
-            for source in readable:
-                destination = right if source is left else left
-                timeout = relay_timeout()
-                if timeout is None:
-                    return
-                source.settimeout(timeout)
-                destination.settimeout(timeout)
-                payload = source.recv(COPY_CHUNK_BYTES)
-                if not payload:
-                    return
-                transferred += len(payload)
-                if transferred > MAX_TUNNEL_BYTES:
-                    return
-                timeout = relay_timeout()
-                if timeout is None:
-                    return
-                destination.settimeout(timeout)
-                destination.sendall(payload)
-                idle_deadline = time.monotonic() + IDLE_TIMEOUT_SECONDS
-    except OSError:
-        return
