-  for (const relativePath of CANDIDATE_FILES) {
-    const checkedAt = now().toISOString();
-    const result = candidateResult(realRoot, relativePath, checkedAt);
-    if (!result.file) {
-      if (result.skipped) skippedFiles.push(result.skipped);
