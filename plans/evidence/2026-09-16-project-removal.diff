-function makeRejectingProxy(state) {
-  const reject = (kind) => {
-    state.proxyAttempts.push({ kind }); // Deliberately omit targets, headers, and bodies from evidence.
-    markFailure(state, "proxy_egress_attempt");
-  };
-  const server = http.createServer((request, response) => {
-    reject("http");
-    response.writeHead(502, { "content-type": "text/plain; charset=utf-8" });
-    response.end("offline probe proxy rejects forwarding");
-  });
-  server.on("connect", (request, socket) => {
-    reject("connect");
-    socket.end("HTTP/1.1 502 Bad Gateway\r\nConnection: close\r\n\r\n");
-  });
