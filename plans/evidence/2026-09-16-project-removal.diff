-function parseArguments(argv: readonly string[]): CliArguments {
-  const values: Partial<Record<OptionName, string>> = {};
-  for (let index = 0; index < argv.length; index += 1) {
-    const token = argv[index];
-    if (!token || !token.startsWith('--')) fail('只支持 --data-dir、--label 和 --root-path 参数');
-    const option = token.slice(2) as OptionName;
-    if (!optionNames.has(option) || values[option] !== undefined) {
-      fail('只支持一次 --data-dir、--label 和 --root-path 参数');
-    }
-    const value = argv[index + 1];
-    if (!value || value.startsWith('--')) fail(`${token} 必须提供值`);
-    values[option] = value;
-    index += 1;
-  }
-
-  if (!values['data-dir'] || !values.label || !values['root-path']) {
-    fail('必须提供 --data-dir、--label 和 --root-path 参数');
-  }
-  return { dataDir: values['data-dir'], label: values.label, rootPath: values['root-path'] };
-}
-
-function requireExplicitAbsolutePath(value: string, option: string): string {
-  if (!isAbsolute(value)) fail(`${option} 必须是绝对路径`);
-  if (
