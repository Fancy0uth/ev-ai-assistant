-class LoopbackUnixBridge:
-    """A short-lived, loopback-only TCP proxy into the read-only Unix socket mount."""
-
-    def __init__(
-        self, socket_path: Path = GATEWAY_SOCKET, process_deadline: float | None = None
-    ) -> None:
-        self._socket_path = socket_path
-        self._process_deadline = process_deadline
-        self._listener: socket.socket | None = None
-        self._stop = threading.Event()
-        self._workers = threading.BoundedSemaphore(MAX_WORKERS)
-        self._thread: threading.Thread | None = None
-        self._active_sockets: set[socket.socket] = set()
-        self._active_lock = threading.Lock()
-        self.port: int | None = None
-
-    def __enter__(self) -> "LoopbackUnixBridge":
-        self.start()
-        return self
-
-    def __exit__(self, _type: object, _value: object, _traceback: object) -> None:
-        self.close()
-
-    def start(self) -> None:
-        if self._listener is not None:
-            raise ClientError("BRIDGE_ALREADY_STARTED")
-        if self._process_deadline is None:
-            self._process_deadline = time.monotonic() + MAX_LIFETIME_SECONDS
-        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
-        try:
-            listener.bind((LOOPBACK_HOST, 0))
-            listener.listen(MAX_WORKERS)
-            listener.settimeout(remaining_timeout(self._process_deadline, 1.0))
-        except ClientError:
-            close_quietly(listener)
-            raise
-        except OSError:
-            close_quietly(listener)
-            raise ClientError("BRIDGE_BIND_FAILED")
-        self._listener = listener
-        self.port = int(listener.getsockname()[1])
-        self._thread = threading.Thread(target=self._accept_loop, daemon=True)
-        self._thread.start()
-
-    def close(self) -> None:
-        self._stop.set()
-        close_quietly(self._listener)
-        with self._active_lock:
-            active_sockets = tuple(self._active_sockets)
-        for active_socket in active_sockets:
-            close_quietly(active_socket)
-        if self._thread is not None:
-            try:
-                self._thread.join(timeout=remaining_timeout(self._process_deadline or 0, 1.0))
-            except ClientError:
-                pass
-        self._listener = None
-
-    def _register_active(self, active_socket: socket.socket) -> bool:
-        with self._active_lock:
-            if self._stop.is_set():
-                should_close = True
-            else:
-                self._active_sockets.add(active_socket)
-                should_close = False
-        if should_close:
-            close_quietly(active_socket)
-        return not should_close
-
-    def _unregister_active(self, active_socket: socket.socket | None) -> None:
-        if active_socket is not None:
-            with self._active_lock:
-                self._active_sockets.discard(active_socket)
-
-    def _accept_loop(self) -> None:
-        deadline = self._process_deadline
-        if deadline is None:
-            return
-        while not self._stop.is_set():
-            listener = self._listener
-            if listener is None:
-                return
-            try:
-                listener.settimeout(remaining_timeout(deadline, 1.0))
-                client, _address = listener.accept()
-            except ClientError:
-                return
-            except socket.timeout:
-                continue
-            except OSError:
-                return
-            if not self._workers.acquire(blocking=False):
-                close_quietly(client)
-                continue
-
-            def worker(connection: socket.socket = client) -> None:
-                upstream: socket.socket | None = None
-                try:
-                    if not self._register_active(connection):
-                        return
-                    upstream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
-                    if not self._register_active(upstream):
-                        return
-                    upstream.settimeout(remaining_timeout(deadline, CONNECT_TIMEOUT_SECONDS))
-                    upstream.connect(os.fspath(self._socket_path))
-                    upstream.settimeout(remaining_timeout(deadline, IDLE_TIMEOUT_SECONDS))
-                    connection.settimeout(remaining_timeout(deadline, IDLE_TIMEOUT_SECONDS))
-                    relay_tunnel(connection, upstream, process_deadline=deadline)
-                except (ClientError, OSError):
-                    pass
-                finally:
-                    self._unregister_active(upstream)
-                    self._unregister_active(connection)
-                    close_quietly(upstream)
-                    close_quietly(connection)
-                    self._workers.release()
-
-            threading.Thread(target=worker, daemon=True).start()
