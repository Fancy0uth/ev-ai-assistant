-function captureLimited(stream) {
-  let bytes = 0;
-  let kept = Buffer.alloc(0);
-  let truncated = false;
-  stream.on("data", (chunk) => {
-    bytes += chunk.length;
-    const room = MAX_OUTPUT_BYTES - kept.length;
-    if (room <= 0) {
-      truncated = true;
-      return;
-    }
-    const piece = chunk.subarray(0, room);
-    kept = Buffer.concat([kept, piece]);
-    if (piece.length !== chunk.length) truncated = true;
-  });
-  return () => ({ bytes, text: kept.toString("utf8"), truncated });
-}
