-function runSingleOwnedChild({ codexExe, args, layout, env, state }) {
-  return new Promise((resolve) => {
-    const startedAt = Date.now();
-    let settled = false;
-    let timeoutHit = false;
-    let stopReason = null;
-    let child;
-    const finish = (result) => {
-      if (settled) return;
-      settled = true;
-      clearTimeout(timeout);
-      state.stopOwnedChild = null;
-      resolve({ elapsedMs: Date.now() - startedAt, stopReason, timeoutHit, ...result });
-    };
-    const stopOwnedChild = (reason) => {
-      if (!stopReason) stopReason = reason;
-      // Direct child only. Do not invoke taskkill, a shell, or process-tree termination.
-      if (child && child.exitCode === null && !child.killed) child.kill();
-    };
-    const timeout = setTimeout(() => {
-      timeoutHit = true;
-      stopOwnedChild("timeout");
-    }, MAX_CALL_MS);
-
-    try {
-      child = spawn(codexExe, args, {
-        cwd: layout.cwd,
-        env,
-        shell: false,
-        stdio: ["ignore", "pipe", "pipe"],
-        windowsHide: true,
-      });
-    } catch {
-      finish({ spawnError: "spawn threw before child creation" });
-      return;
-    }
-    state.stopOwnedChild = stopOwnedChild;
-    const stdout = captureLimited(child.stdout);
-    const stderr = captureLimited(child.stderr);
-    child.once("error", () => finish({ spawnError: "child process failed to start", stdout: stdout(), stderr: stderr() }));
-    child.once("close", (exitCode, signal) => finish({ exitCode, signal, stdout: stdout(), stderr: stderr() }));
-  });
-}
