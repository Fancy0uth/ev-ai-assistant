+
+interface ProjectConversationMessage {
+  id: string;
+  sessionId: string;
+  sequence: number;
+  content: string;
+  role: 'USER';
+  createdAt: string;
+}
+
+interface ProjectConversationAppendResult {
+  message: ProjectConversationMessage;
+  replayed: boolean;
+}
+
+interface ProjectConversationContext {
+  schemaVersion: 'PROJECT_CONVERSATION_CONTEXT_V1';
+  userReports: Array<{
+    messageId: string;
+    sequence: number;
+    content: string;
+    source: 'USER_REPORTED';
+  }>;
+  memory: { content: string; version: number; source: 'CURRENT_PROJECT_MEMORY' } | null;
+  files: Array<{
+    relativePath: string;
+    content: string;
+    contentHash: string;
+    source: 'PROJECT_FILE';
+  }>;
+  omissions: {
+    olderMessages: boolean;
+    messageIds: string[];
+    files: Array<{ relativePath: string; reason: string }>;
+    memory: boolean;
+  };
+}
+
+interface ScopeSnapshot {
+  scope: {
+    id: string;
+    label: string;
+    rootPath: string;
+    createdAt: string;
+    updatedAt: string;
+  };
+  snapshot: {
+    root: string;
+    files: Array<{
+      relativePath: string;
+      content: string;
+      contentHash: string;
+      byteLength: number;
+      readAt: string;
+    }>;
+    skipped: Array<{ relativePath: string; reason: string; checkedAt: string }>;
+    totalBytes: number;
+  };
+}
+
+interface EntityMemoryDocument {
+  scopeType: 'PROJECT';
+  scopeId: string;
+  content: string;
+  version: number;
+  createdAt: string;
+  updatedAt: string;
+}
+
+interface ProjectConversationService {
+  recordProgress(
+    ownerId: string,
+    projectId: string,
+    input: { clientMessageId: string; content: string },
+  ): ProjectConversationAppendResult;
+  buildContext(ownerId: string, projectId: string): ProjectConversationContext;
+}
+
+async function loadConversationService(): Promise<{
+  createProjectConversationService(input: {
+    conversations: {
+      appendUserMessage(
+        ownerId: string,
+        projectId: string,
+        input: { clientMessageId: string; content: string },
+      ): ProjectConversationAppendResult;
+      listMessages(
+        ownerId: string,
+        projectId: string,
+        input: { limit: number; beforeSequence?: number },
+      ): ProjectConversationMessage[];
+    };
+    scopes: { snapshot(ownerId: string, projectId: string): ScopeSnapshot };
+    memory: {
+      read(
+        ownerId: string,
+        identity: { scopeType: 'PROJECT'; scopeId: string },
+      ): EntityMemoryDocument | undefined;
+    };
+  }): ProjectConversationService;
+}> {
+  const modulePath = '../src/modules/projects/conversation-service';
+  return import(modulePath) as Promise<{
+    createProjectConversationService(input: {
+      conversations: {
+        appendUserMessage(
+          ownerId: string,
+          projectId: string,
+          input: { clientMessageId: string; content: string },
+        ): ProjectConversationAppendResult;
+        listMessages(
+          ownerId: string,
+          projectId: string,
+          input: { limit: number; beforeSequence?: number },
+        ): ProjectConversationMessage[];
+      };
+      scopes: { snapshot(ownerId: string, projectId: string): ScopeSnapshot };
+      memory: {
+        read(
+          ownerId: string,
+          identity: { scopeType: 'PROJECT'; scopeId: string },
+        ): EntityMemoryDocument | undefined;
+      };
+    }): ProjectConversationService;
+  }>;
+}
+
+function rowCount(database: Database.Database, table: string): number {
+  return (database.prepare(`select count(*) as count from ${table}`).get() as { count: number }).count;
+}
+
+function expectApiError(operation: () => unknown, statusCode: number, code: string): void {
+  let thrown: unknown;
+  try {
+    operation();
+  } catch (error) {
+    thrown = error;
+  }
+  expect(thrown).toBeInstanceOf(ApiError);
+  expect(thrown).toMatchObject({ statusCode, code });
+}
+
