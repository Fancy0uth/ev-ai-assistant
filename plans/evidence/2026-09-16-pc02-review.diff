+import { createEntityMemoryService } from '../memory/entity-service';
+import type { ProjectConversationRepository } from './conversation-repository';
+import { projectConversationContext } from './conversation-context';
+import { createProjectScopeService } from './scope-service';
+
+export function createProjectConversationService(dependencies: {
+  conversations: Pick<ProjectConversationRepository, 'appendUserMessage' | 'listMessages'>;
+  scopes: Pick<ReturnType<typeof createProjectScopeService>, 'snapshot'>;
+  memory: Pick<ReturnType<typeof createEntityMemoryService>, 'read'>;
+}) {
+  return {
+    recordProgress(
+      ownerId: string,
+      projectId: string,
+      input: { clientMessageId: string; content: string },
+    ) {
+      return dependencies.conversations.appendUserMessage(ownerId, projectId, input);
+    },
+    buildContext(ownerId: string, projectId: string) {
+      const messages = dependencies.conversations.listMessages(ownerId, projectId, { limit: 51 });
+      const scopeSnapshot = dependencies.scopes.snapshot(ownerId, projectId);
+      const memory = dependencies.memory.read(ownerId, { scopeType: 'PROJECT', scopeId: projectId });
+      return projectConversationContext({ messages, scopeSnapshot, memory });
+    },
+  };
+}

