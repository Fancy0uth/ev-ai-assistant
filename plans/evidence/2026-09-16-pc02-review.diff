+import type { EntityMemoryDocument } from '../memory/entity-service';
+import type { ProjectConversationMessage } from './conversation-repository';
+import type { createProjectScopeService } from './scope-service';
+
+const USER_REPORT_LIMIT = 50;
+const USER_REPORT_BYTE_LIMIT = 32_000;
+const MEMORY_BYTE_LIMIT = 16_000;
+const FILE_BYTE_LIMIT = 16_000;
+const TOTAL_FILE_BYTE_LIMIT = 64_000;
+
+type ProjectScopeSnapshot = ReturnType<ReturnType<typeof createProjectScopeService>['snapshot']>;
+
+export interface ProjectConversationContext {
+  schemaVersion: 'PROJECT_CONVERSATION_CONTEXT_V1';
+  userReports: Array<{
+    messageId: string;
+    sequence: number;
+    content: string;
+    source: 'USER_REPORTED';
+  }>;
+  memory: {
+    content: string;
+    version: number;
+    source: 'CURRENT_PROJECT_MEMORY';
+  } | null;
+  files: Array<{
+    relativePath: string;
+    content: string;
+    contentHash: string;
+    source: 'PROJECT_FILE';
+  }>;
+  omissions: {
+    olderMessages: boolean;
+    messageIds: string[];
+    files: Array<{ relativePath: string; reason: string }>;
+    memory: boolean;
+  };
+}
+
+export interface ProjectConversationContextInput {
+  messages: readonly ProjectConversationMessage[];
+  scopeSnapshot: ProjectScopeSnapshot;
+  memory: EntityMemoryDocument | undefined;
+}
+
+function projectUserReports(messages: readonly ProjectConversationMessage[]): Pick<
+  ProjectConversationContext,
+  'userReports' | 'omissions'
+> {
+  const visibleMessages = messages.slice(-USER_REPORT_LIMIT);
+  const omittedMessageIds = messages
+    .slice(0, messages.length - visibleMessages.length)
+    .map((message) => message.id);
+  const userReports: ProjectConversationContext['userReports'] = [];
+  let totalBytes = 0;
+
+  for (let index = visibleMessages.length - 1; index >= 0; index -= 1) {
+    const message = visibleMessages[index]!;
+    const messageBytes = Buffer.byteLength(message.content, 'utf8');
+    if (totalBytes + messageBytes > USER_REPORT_BYTE_LIMIT) {
+      omittedMessageIds.push(...visibleMessages.slice(0, index + 1).map((olderMessage) => olderMessage.id));
+      break;
+    }
+    totalBytes += messageBytes;
+    userReports.push({
+      messageId: message.id,
+      sequence: message.sequence,
+      content: message.content,
+      source: 'USER_REPORTED',
+    });
+  }
+
+  return {
+    userReports: userReports.reverse(),
+    omissions: {
+      olderMessages: omittedMessageIds.length > 0,
+      messageIds: omittedMessageIds,
+      files: [],
+      memory: false,
+    },
+  };
+}
+
+function projectMemory(memory: EntityMemoryDocument | undefined): Pick<
+  ProjectConversationContext,
+  'memory' | 'omissions'
+> {
+  if (!memory) {
+    return {
+      memory: null,
+      omissions: { olderMessages: false, messageIds: [], files: [], memory: false },
+    };
+  }
+  if (Buffer.byteLength(memory.content, 'utf8') > MEMORY_BYTE_LIMIT) {
+    return {
+      memory: null,
+      omissions: { olderMessages: false, messageIds: [], files: [], memory: true },
+    };
+  }
+  return {
+    memory: {
+      content: memory.content,
+      version: memory.version,
+      source: 'CURRENT_PROJECT_MEMORY',
+    },
+    omissions: { olderMessages: false, messageIds: [], files: [], memory: false },
+  };
+}
+
+function projectFiles(scopeSnapshot: ProjectScopeSnapshot): Pick<
+  ProjectConversationContext,
+  'files' | 'omissions'
+> {
+  const files: ProjectConversationContext['files'] = [];
+  const omissions: ProjectConversationContext['omissions']['files'] = scopeSnapshot.snapshot.skipped
+    .map(({ relativePath, reason }) => ({ relativePath, reason }));
+  let totalBytes = 0;
+
+  for (const file of scopeSnapshot.snapshot.files) {
+    const fileBytes = Buffer.byteLength(file.content, 'utf8');
+    if (fileBytes > FILE_BYTE_LIMIT) {
+      omissions.push({ relativePath: file.relativePath, reason: 'CONTEXT_FILE_LIMIT' });
+      continue;
+    }
+    if (totalBytes + fileBytes > TOTAL_FILE_BYTE_LIMIT) {
+      omissions.push({ relativePath: file.relativePath, reason: 'CONTEXT_TOTAL_LIMIT' });
+      continue;
+    }
+    totalBytes += fileBytes;
+    files.push({
+      relativePath: file.relativePath,
+      content: file.content,
+      contentHash: file.contentHash,
+      source: 'PROJECT_FILE',
+    });
+  }
+
+  return {
+    files,
+    omissions: { olderMessages: false, messageIds: [], files: omissions, memory: false },
+  };
+}
+
+export function projectConversationContext(input: ProjectConversationContextInput): ProjectConversationContext {
+  const reports = projectUserReports(input.messages);
+  const memory = projectMemory(input.memory);
+  const files = projectFiles(input.scopeSnapshot);
+  return {
+    schemaVersion: 'PROJECT_CONVERSATION_CONTEXT_V1',
+    userReports: reports.userReports,
+    memory: memory.memory,
+    files: files.files,
+    omissions: {
+      olderMessages: reports.omissions.olderMessages,
+      messageIds: reports.omissions.messageIds,
+      files: files.omissions.files,
+      memory: memory.omissions.memory,
+    },
+  };
+}

