+import Database from 'better-sqlite3';
+import { describe, expect, it } from 'vitest';
+import { ApiError } from '../src/http/api-error';
+import { runMigrations } from '../src/storage/migrations';
+
+interface ProjectConversation {
+  id: string;
+  projectId: string;
+  createdAt: string;
+}
+
+interface ProjectConversationMessage {
+  id: string;
+  sessionId: string;
+  sequence: number;
+  content: string;
+  role: 'USER';
+  createdAt: string;
+}
+
+interface ProjectConversationRepository {
+  getOrCreate(ownerId: string, projectId: string): ProjectConversation;
+  appendUserMessage(
+    ownerId: string,
+    projectId: string,
+    input: { clientMessageId: string; content: string },
+  ): { message: ProjectConversationMessage; replayed: boolean };
+  listMessages(
+    ownerId: string,
+    projectId: string,
+    input: { limit: number; beforeSequence?: number },
+  ): ProjectConversationMessage[];
+}
+
+async function loadConversationRepository(): Promise<{
+  createProjectConversationRepository(database: Database.Database): ProjectConversationRepository;
+}> {
+  const modulePath = '../src/modules/projects/conversation-repository';
+  return import(modulePath) as Promise<{
+    createProjectConversationRepository(database: Database.Database): ProjectConversationRepository;
+  }>;
+}
+
+function rowCount(database: Database.Database, table: string): number {
+  return (database.prepare(`select count(*) as count from ${table}`).get() as { count: number }).count;
+}
+
+function expectApiError(operation: () => unknown, statusCode: number, code: string): void {
+  let thrown: unknown;
+  try {
+    operation();
+  } catch (error) {
+    thrown = error;
+  }
+  expect(thrown).toBeInstanceOf(ApiError);
+  expect(thrown).toMatchObject({ statusCode, code });
+}
+
+describe('PC-01 project conversation repository', () => {
+  it('upgrades only v26 to v27, binds every operation to its Owner and project scope, and persists ordered idempotent user messages', async () => {
+    const database = new Database(':memory:');
+    const timestamp = '2026-09-16T00:00:00.000Z';
+    const ownerId = 'pc01-owner';
+    const firstProjectId = 'pc01-project-one';
+    const secondProjectId = 'pc01-project-two';
+    const firstClientMessageId = '00000000-0000-4000-8000-000000002701';
+    const secondClientMessageId = '00000000-0000-4000-8000-000000002702';
+
+    try {
+      database.pragma('foreign_keys = ON');
+      runMigrations(database, 26);
+      expect(database.prepare('select max(version) as version from schema_migrations').get()).toEqual({ version: 26 });
+
+      database.prepare(
+        'insert into owners (id, username, password_hash, created_at) values (?, ?, ?, ?)',
+      ).run(ownerId, 'pc01-owner', 'synthetic-hash', timestamp);
+      database.prepare(`insert into project_scopes (
+        id, owner_id, label, root_path, created_at, updated_at
+      ) values (?, ?, ?, ?, ?, ?)`).run(
+        firstProjectId,
+        ownerId,
+        'PC-01 first synthetic project',
+        '/synthetic/pc01/first',
+        timestamp,
+        timestamp,
+      );
+      database.prepare(`insert into project_scopes (
+        id, owner_id, label, root_path, created_at, updated_at
+      ) values (?, ?, ?, ?, ?, ?)`).run(
+        secondProjectId,
+        ownerId,
+        'PC-01 second synthetic project',
+        '/synthetic/pc01/second',
+        timestamp,
+        timestamp,
+      );
+      database.prepare(`insert into tasks (
+        id, owner_id, title, area, priority, status, target_date, completed_at,
+        version, created_at, updated_at
+      ) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(
+        'pc01-existing-task',
+        ownerId,
+        'Retain synthetic task through project conversation migration',
+        'WORK',
+        'HIGH',
+        'OPEN',
+        null,
+        null,
+        1,
+        timestamp,
+        timestamp,
+      );
+      database.prepare(
+        'insert into agent_sessions (id, owner_id, title, created_at, updated_at) values (?, ?, ?, ?, ?)',
+      ).run('pc01-generic-agent-session', ownerId, 'Retained generic agent session', timestamp, timestamp);
+      database.prepare(
+        'insert into agent_messages (id, session_id, role, content, created_at) values (?, ?, ?, ?, ?)',
+      ).run('pc01-generic-agent-message', 'pc01-generic-agent-session', 'USER', 'Retained generic message', timestamp);
+
+      runMigrations(database);
+      expect(
+        database.prepare('select version, name from schema_migrations where version = 27').get(),
+      ).toEqual({ version: 27, name: 'add_project_conversation_storage' });
+
+      expect(database.prepare('select id, username from owners where id = ?').get(ownerId)).toEqual({
+        id: ownerId,
+        username: 'pc01-owner',
+      });
+      expect(database.prepare('select id, owner_id from tasks where id = ?').get('pc01-existing-task')).toEqual({
+        id: 'pc01-existing-task',
+        owner_id: ownerId,
+      });
+      expect(database.prepare('select id from agent_sessions where id = ?').get('pc01-generic-agent-session')).toEqual({
+        id: 'pc01-generic-agent-session',
+      });
+      expect(database.prepare('select id from agent_messages where id = ?').get('pc01-generic-agent-message')).toEqual({
+        id: 'pc01-generic-agent-message',
+      });
+      expect(
+        database.prepare("select name from sqlite_master where type = 'table' and name like 'project_conversation%' order by name").all(),
+      ).toEqual([
+        { name: 'project_conversation_messages' },
+        { name: 'project_conversations' },
+      ]);
+
+      const { createProjectConversationRepository } = await loadConversationRepository();
+      const repository = createProjectConversationRepository(database);
+      const firstConversation = repository.getOrCreate(ownerId, firstProjectId);
+      expect(firstConversation).toMatchObject({
+        id: expect.any(String),
+        projectId: firstProjectId,
+        createdAt: expect.any(String),
+      });
+      expect(repository.getOrCreate(ownerId, firstProjectId)).toEqual(firstConversation);
+
+      const firstAppend = repository.appendUserMessage(ownerId, firstProjectId, {
+        clientMessageId: firstClientMessageId,
+        content: '  First project update is persisted before any provider work.  ',
+      });
+      const secondAppend = repository.appendUserMessage(ownerId, firstProjectId, {
+        clientMessageId: secondClientMessageId,
+        content: 'Second project update follows the durable first update.',
+      });
+      expect(firstAppend).toMatchObject({
+        replayed: false,
+        message: {
+          id: expect.any(String),
+          sessionId: firstConversation.id,
+          sequence: expect.any(Number),
+          content: 'First project update is persisted before any provider work.',
+          role: 'USER',
+          createdAt: expect.any(String),
+        },
+      });
+      expect(secondAppend.message.sequence).toBeGreaterThan(firstAppend.message.sequence);
+      expect(repository.listMessages(ownerId, firstProjectId, { limit: 10 })).toEqual([
+        firstAppend.message,
+        secondAppend.message,
+      ]);
+      expect(repository.listMessages(ownerId, firstProjectId, {
+        limit: 1,
+        beforeSequence: secondAppend.message.sequence,
+      })).toEqual([firstAppend.message]);
+
+      const replay = repository.appendUserMessage(ownerId, firstProjectId, {
+        clientMessageId: firstClientMessageId,
+        content: 'First project update is persisted before any provider work.',
+      });
+      expect(replay).toEqual({ message: firstAppend.message, replayed: true });
+      expectApiError(() => repository.appendUserMessage(ownerId, firstProjectId, {
+        clientMessageId: firstClientMessageId,
+        content: 'Conflicting content must not overwrite the persisted update.',
+      }), 409, 'PROJECT_MESSAGE_CONFLICT');
+      expect(rowCount(database, 'project_conversation_messages')).toBe(2);
+
+      expect(repository.listMessages(ownerId, secondProjectId, { limit: 10 })).toEqual([]);
+      expect(rowCount(database, 'project_conversations')).toBe(1);
+      const secondConversation = repository.getOrCreate(ownerId, secondProjectId);
+      expect(secondConversation.id).not.toBe(firstConversation.id);
+      expect(repository.listMessages(ownerId, secondProjectId, { limit: 10 })).toEqual([]);
+
+      expectApiError(() => repository.appendUserMessage(ownerId, firstProjectId, {
+        clientMessageId: 'not-a-uuid',
+        content: 'Invalid client id is rejected.',
+      }), 400, 'PROJECT_MESSAGE_INVALID');
+      expectApiError(() => repository.appendUserMessage(ownerId, firstProjectId, {
+        clientMessageId: '00000000-0000-4000-8000-000000002703',
+        content: '   ',
+      }), 400, 'PROJECT_MESSAGE_INVALID');
+      expectApiError(() => repository.listMessages(ownerId, firstProjectId, { limit: 0 }), 400, 'PROJECT_MESSAGE_INVALID');
+      expectApiError(() => repository.listMessages(ownerId, firstProjectId, {
+        limit: 1,
+        beforeSequence: 0,
+      }), 400, 'PROJECT_MESSAGE_INVALID');
+
+      const beforeForbiddenAccess = {
+        conversations: rowCount(database, 'project_conversations'),
+        messages: rowCount(database, 'project_conversation_messages'),
+      };
+      expectApiError(() => repository.getOrCreate('pc01-other-owner', firstProjectId), 404, 'PROJECT_SCOPE_NOT_FOUND');
+      expectApiError(() => repository.appendUserMessage('pc01-other-owner', firstProjectId, {
+        clientMessageId: '00000000-0000-4000-8000-000000002704',
+        content: 'Other Owner cannot append.',
+      }), 404, 'PROJECT_SCOPE_NOT_FOUND');
+      expectApiError(() => repository.listMessages('pc01-other-owner', firstProjectId, { limit: 10 }), 404, 'PROJECT_SCOPE_NOT_FOUND');
+      expectApiError(() => repository.getOrCreate(ownerId, 'pc01-missing-project'), 404, 'PROJECT_SCOPE_NOT_FOUND');
+      expect({
+        conversations: rowCount(database, 'project_conversations'),
+        messages: rowCount(database, 'project_conversation_messages'),
+      }).toEqual(beforeForbiddenAccess);
+      expect(rowCount(database, 'tasks')).toBe(1);
+      expect(rowCount(database, 'actions')).toBe(0);
+      expect(rowCount(database, 'time_requests')).toBe(0);
+      expect(rowCount(database, 'proposals')).toBe(0);
+      expect(rowCount(database, 'events')).toBe(0);
+    } finally {
+      database.close();
+    }
+  });
+});


