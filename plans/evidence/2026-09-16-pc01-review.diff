+import { randomUUID } from 'node:crypto';
+import type Database from 'better-sqlite3';
+import { ApiError } from '../../http/api-error';
+
+export interface ProjectConversation {
+  id: string;
+  projectId: string;
+  createdAt: string;
+}
+
+export interface ProjectConversationMessage {
+  id: string;
+  sessionId: string;
+  sequence: number;
+  content: string;
+  role: 'USER';
+  createdAt: string;
+}
+
+export interface ProjectConversationRepository {
+  getOrCreate(ownerId: string, projectId: string): ProjectConversation;
+  appendUserMessage(
+    ownerId: string,
+    projectId: string,
+    input: { clientMessageId: string; content: string },
+  ): { message: ProjectConversationMessage; replayed: boolean };
+  listMessages(
+    ownerId: string,
+    projectId: string,
+    input: { limit: number; beforeSequence?: number },
+  ): ProjectConversationMessage[];
+}
+
+interface ConversationRow {
+  id: string;
+  project_scope_id: string;
+  created_at: string;
+}
+
+interface MessageRow {
+  id: string;
+  session_id: string;
+  sequence: number;
+  content: string;
+  role: 'USER';
+  created_at: string;
+}
+
+const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+function toConversation(row: ConversationRow): ProjectConversation {
+  return { id: row.id, projectId: row.project_scope_id, createdAt: row.created_at };
+}
+
+function toMessage(row: MessageRow): ProjectConversationMessage {
+  return {
+    id: row.id,
+    sessionId: row.session_id,
+    sequence: row.sequence,
+    content: row.content,
+    role: row.role,
+    createdAt: row.created_at,
+  };
+}
+
+function projectScopeNotFound(): never {
+  throw new ApiError(404, 'PROJECT_SCOPE_NOT_FOUND', '项目范围不存在');
+}
+
+function invalidMessage(): never {
+  throw new ApiError(400, 'PROJECT_MESSAGE_INVALID', '项目消息输入无效');
+}
+
+function isConstraintError(error: unknown): boolean {
+  return typeof error === 'object'
+    && error !== null
+    && 'code' in error
+    && typeof error.code === 'string'
+    && error.code.startsWith('SQLITE_CONSTRAINT');
+}
+
+function normalizeMessageInput(input: { clientMessageId: string; content: string }): {
+  clientMessageId: string;
+  content: string;
+} {
+  const candidate = input as unknown;
+  if (typeof candidate !== 'object' || candidate === null) invalidMessage();
+  const { clientMessageId, content } = candidate as { clientMessageId?: unknown; content?: unknown };
+  if (typeof clientMessageId !== 'string' || !uuidPattern.test(clientMessageId) || typeof content !== 'string') {
+    invalidMessage();
+  }
+  const normalizedContent = content.trim();
+  if (Array.from(normalizedContent).length < 1 || Array.from(normalizedContent).length > 8000) invalidMessage();
+  return { clientMessageId, content: normalizedContent };
+}
+
+function normalizeListInput(input: { limit: number; beforeSequence?: number }): {
+  limit: number;
+  beforeSequence: number | null;
+} {
+  const candidate = input as unknown;
+  if (typeof candidate !== 'object' || candidate === null) invalidMessage();
+  const { limit, beforeSequence } = candidate as { limit?: unknown; beforeSequence?: unknown };
+  if (!Number.isInteger(limit) || limit < 1 || limit > 100) invalidMessage();
+  if (beforeSequence !== undefined && (!Number.isSafeInteger(beforeSequence) || beforeSequence < 1)) invalidMessage();
+  return { limit, beforeSequence: beforeSequence ?? null };
+}
+
+export function createProjectConversationRepository(database: Database.Database): ProjectConversationRepository {
+  const findScope = database.prepare('select id from project_scopes where owner_id = ? and id = ?');
+  const findConversation = database.prepare(
+    'select id, project_scope_id, created_at from project_conversations where owner_id = ? and project_scope_id = ?',
+  );
+  const insertConversation = database.prepare(
+    'insert into project_conversations (id, owner_id, project_scope_id, created_at) values (?, ?, ?, ?)',
+  );
+  const findMessageByClientId = database.prepare(
+    `select id, session_id, sequence, content, role, created_at
+     from project_conversation_messages where session_id = ? and client_message_id = ?`,
+  );
+  const insertMessage = database.prepare(
+    `insert into project_conversation_messages (
+      id, session_id, client_message_id, role, content, created_at
+    ) values (?, ?, ?, 'USER', ?, ?)`,
+  );
+  const listMessageRows = database.prepare(
+    `select message.id, message.session_id, message.sequence, message.content, message.role, message.created_at
+     from project_conversation_messages as message
+     join project_conversations as conversation on conversation.id = message.session_id
+     where conversation.owner_id = ?
+       and conversation.project_scope_id = ?
+       and (? is null or message.sequence < ?)
+     order by message.sequence desc
+     limit ?`,
+  );
+
+  function assertScope(ownerId: string, projectId: string): void {
+    if (!findScope.get(ownerId, projectId)) projectScopeNotFound();
+  }
+
+  function findOrCreateConversation(ownerId: string, projectId: string): ProjectConversation {
+    const existing = findConversation.get(ownerId, projectId) as ConversationRow | undefined;
+    if (existing) return toConversation(existing);
+    const timestamp = new Date().toISOString();
+    try {
+      insertConversation.run(randomUUID(), ownerId, projectId, timestamp);
+    } catch (error) {
+      if (!isConstraintError(error)) throw error;
+    }
+    const created = findConversation.get(ownerId, projectId) as ConversationRow | undefined;
+    if (!created) throw new Error('PROJECT_CONVERSATION_NOT_PERSISTED');
+    return toConversation(created);
+  }
+
+  const getOrCreate = database.transaction((ownerId: string, projectId: string): ProjectConversation => {
+    assertScope(ownerId, projectId);
+    return findOrCreateConversation(ownerId, projectId);
+  });
+
+  const appendUserMessage = database.transaction((
+    ownerId: string,
+    projectId: string,
+    input: { clientMessageId: string; content: string },
+  ): { message: ProjectConversationMessage; replayed: boolean } => {
+    assertScope(ownerId, projectId);
+    const normalized = normalizeMessageInput(input);
+    const conversation = findOrCreateConversation(ownerId, projectId);
+    const existing = findMessageByClientId.get(conversation.id, normalized.clientMessageId) as MessageRow | undefined;
+    if (existing) {
+      if (existing.content !== normalized.content) {
+        throw new ApiError(409, 'PROJECT_MESSAGE_CONFLICT', '同一消息标识不能对应不同正文');
+      }
+      return { message: toMessage(existing), replayed: true };
+    }
+
+    try {
+      insertMessage.run(randomUUID(), conversation.id, normalized.clientMessageId, normalized.content, new Date().toISOString());
+    } catch (error) {
+      if (!isConstraintError(error)) throw error;
+      const replayed = findMessageByClientId.get(conversation.id, normalized.clientMessageId) as MessageRow | undefined;
+      if (!replayed) throw error;
+      if (replayed.content !== normalized.content) {
+        throw new ApiError(409, 'PROJECT_MESSAGE_CONFLICT', '同一消息标识不能对应不同正文');
+      }
+      return { message: toMessage(replayed), replayed: true };
+    }
+
+    const created = findMessageByClientId.get(conversation.id, normalized.clientMessageId) as MessageRow | undefined;
+    if (!created) throw new Error('PROJECT_MESSAGE_NOT_PERSISTED');
+    return { message: toMessage(created), replayed: false };
+  });
+
+  const listMessages = database.transaction((
+    ownerId: string,
+    projectId: string,
+    input: { limit: number; beforeSequence?: number },
+  ): ProjectConversationMessage[] => {
+    assertScope(ownerId, projectId);
+    const { limit, beforeSequence } = normalizeListInput(input);
+    return (listMessageRows.all(ownerId, projectId, beforeSequence, beforeSequence, limit) as MessageRow[])
+      .reverse()
+      .map(toMessage);
+  });
+
+  return { getOrCreate, appendUserMessage, listMessages };
+}

